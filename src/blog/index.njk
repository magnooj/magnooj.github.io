---
layout: layouts/base.njk
title: Writing
description: Notes on medical AI for clinicians and students, on data, labels and evaluation.
permalink: /blog/
crumb: { label: "Writing", url: "/blog/" }
---
<main class="main">
  <h1>Writing</h1>
  <p class="dek">Notes on medical AI for clinicians and students, on the data, labels and evaluation that decide whether a model can be trusted.</p>
  <ul class="pills" id="filters">
    <li><button type="button" data-tag="" aria-pressed="true">All<span class="count">{{ collections.posts.length }}</span></button></li>
    {%- for label in collections.posts | allLabels %}
    <li><button type="button" data-tag="{{ label.name | slugify }}" aria-pressed="false">{{ label.name }}<span class="count">{{ label.count }}</span></button></li>
    {%- endfor %}
  </ul>
  <div class="post-list-head">
    {%- for post in collections.posts %}
    {% include "partials/post-card.njk" %}
    {%- endfor %}
  </div>
</main>
<script>
(() => {
  const buttons = [...document.querySelectorAll("#filters button")];
  const cards = [...document.querySelectorAll(".post-card")];
  const apply = (tag) => {
    buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.tag === tag)));
    cards.forEach((c) => { c.hidden = tag && !c.dataset.tags.split(" ").includes(tag); });
  };
  buttons.forEach((b) => b.addEventListener("click", () => {
    const url = new URL(location.href);
    b.dataset.tag ? url.searchParams.set("tag", b.dataset.tag) : url.searchParams.delete("tag");
    history.replaceState(null, "", url);
    apply(b.dataset.tag);
  }));
  const start = new URLSearchParams(location.search).get("tag") || "";
  if (buttons.some((b) => b.dataset.tag === start)) apply(start);
})();
</script>
