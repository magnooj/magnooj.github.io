---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title }}</title>
  <subtitle>{{ site.description }}</subtitle>
  <link href="{{ '/feed.xml' | absoluteUrl(site.url) }}" rel="self"/>
  <link href="{{ site.url }}/"/>
  <id>{{ site.url }}/</id>
  <author><name>{{ site.author }}</name></author>
  {%- set latest = collections.posts | first %}
  <updated>{{ (latest.date if latest else page.date) | isoDate }}</updated>
  {%- for post in collections.posts %}
  {%- set absUrl = post.url | absoluteUrl(site.url) %}
  <entry>
    <title>{{ post.data.title }}</title>
    <link href="{{ absUrl }}"/>
    <id>{{ absUrl }}</id>
    <updated>{{ post.date | isoDate }}</updated>
    <summary>{{ post.data.description }}</summary>
  </entry>
  {%- endfor %}
</feed>
