<article class="post-card" data-tags="{% for l in post.data.labels %}{{ l | slugify }} {% endfor %}">
  <a class="thumb" href="{{ post.url }}" tabindex="-1" aria-hidden="true"><img src="{{ post.data.ogImage }}" alt="" width="1200" height="627" loading="lazy"></a>
  <div class="body">
    <p class="meta"><span class="k">{{ post.data.topic }}</span>{% for l in post.data.labels %}<a class="tag" href="/blog/?tag={{ l | slugify }}">{{ l }}</a>{% endfor %}<span>{{ post.date | shortDate }}</span><span>~{{ post.content | readingTime }}</span></p>
    <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
    <p class="sum">{{ post.data.summary or post.data.description }}</p>
  </div>
</article>
