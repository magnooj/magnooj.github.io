---
layout: layouts/base.njk
---
<main class="main">
  <section class="intro">
    <div>
      <p class="kicker">Physician-scientist · Medical imaging AI</p>
      <h1>Ali Ganjizadeh</h1>
      <p class="dek">I work on the data, labels and evaluation that decide whether a medical AI model can be trusted.</p>
      <p>MD, MBA. Senior Technical Product Manager at HOPPR, Research Collaborator at the Mayo Clinic Radiology AI &amp; Informatics Lab, and Vice Chair of the SIIM AI Education Committee.</p>
      <ul class="pills">
        <li><a class="primary" href="/blog/">Writing</a></li>
        <li><a href="{{ site.links.scholar }}">Google Scholar</a></li>
        <li><a href="{{ site.links.github }}">GitHub</a></li>
        <li><a href="{{ site.links.linkedin }}">LinkedIn</a></li>
        <li><a href="{{ site.links.x }}">X</a></li>
      </ul>
    </div>
    <img class="photo" src="/assets/img/ali.jpg" alt="Portrait of Ali Ganjizadeh" width="120" height="120">
  </section>

  <section id="writing">
    <h2 class="label">Writing <a href="/blog/">All posts →</a></h2>
    <p class="section-sub">Notes on medical AI for clinicians and students: data, labels and evaluation.</p>
    {%- for post in collections.posts | head(3) %}
    {% include "partials/post-card.njk" %}
    {%- endfor %}
  </section>

  <section id="talks">
    <h2 class="label">Talks</h2>
    <ol class="cv">
      {%- for talk in talks %}
      <li><span class="when">{{ talk.date }}</span><span><b>{{ talk.title }}</b> <span class="org">· {{ talk.venue }}</span>
        <span class="note">{% for link in talk.links %}{% if not loop.first %} · {% endif %}<a href="{{ link.url }}">{{ link.label }}</a>{% endfor %}</span></span></li>
      {%- endfor %}
    </ol>
  </section>

  <section id="experience">
    <h2 class="label">Experience <a href="/about/">About me →</a></h2>
    <ol class="cv">
      <li><span class="when">Sep 2025 – now</span><span><b>Senior Technical Product Manager</b> <span class="org">· HOPPR</span>
        <span class="note">Foundation models for medical imaging, across the data and model lifecycle.</span></span></li>
      <li><span class="when">Jan 2025 – Sep 2025</span><span><b>Research Scientist</b> <span class="org">· HOPPR</span></span></li>
      <li><span class="when">Jan 2025 – now</span><span><b>Research Collaborator</b> <span class="org">· Mayo Clinic, Radiology AI &amp; Informatics Lab</span></span></li>
      <li><span class="when">Oct 2022 – Jan 2025</span><span><b>Postdoctoral Research Fellow</b> <span class="org">· Mayo Clinic, Radiology AI &amp; Informatics Lab</span>
        <span class="note">Computer vision, language models and informatics for radiology research.</span></span></li>
      <li><span class="when">Jan 2021 – Jul 2022</span><span><b>Product Manager</b> <span class="org">· Neuronio</span></span></li>
      <li><span class="when">Nov 2020 – Jul 2022</span><span><b>Emergency Physician</b> <span class="org">· Susangerd General Hospital, Iran</span></span></li>
    </ol>
  </section>
</main>
